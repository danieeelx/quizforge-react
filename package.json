{
  "name": "quizforge-react",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "description": "A local-first React app that turns PDFs and notes into editable mock exams.",
  "scripts": {
    "build": "tsc -p tsconfig.emit.json && node copy-assets.mjs",
    "start": "node server.mjs",
    "dev": "npm run build && node server.mjs",
    "check": "tsc -p tsconfig.emit.json --noEmit",
    "test:parser": "node tests/parser-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
